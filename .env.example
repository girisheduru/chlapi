# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URL=mongodb://localhost:27017

# Database Name
DATABASE_NAME=chl_datastore_db

# LLM Configuration
# OpenAI API Key (required for LLM endpoints)
LLM_API_KEY=your_openai_api_key_here

# LLM Model (default: gpt-4)
LLM_MODEL=gpt-4

# Optional: Custom LLM API base URL (for other providers)
# LLM_API_BASE_URL=https://api.openai.com/v1

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
