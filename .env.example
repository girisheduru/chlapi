# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URL=mongodb://localhost:27017

# Database Name
DATABASE_NAME=chl_datastore_db

# LLM Configuration
# OpenRouter API Key (required for LLM endpoints)
LLM_API_KEY=your_openrouter_api_key_here

# LLM Model (use OpenRouter model ids)
LLM_MODEL=openai/gpt-4o-mini

# OpenRouter base URL
LLM_API_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers:
# OPENROUTER_SITE_URL=https://your-app-domain.com
# OPENROUTER_APP_NAME=CHL App

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
